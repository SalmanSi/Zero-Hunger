# Supabase: use the transaction pooler (port 6543) for runtime,
# and the session pooler (port 5432) for migrations / direct URL.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
JWT_SECRET=your-super-secure-random-secret-key-min-32-chars
PORT=5000
CORS_ORIGINS=http://localhost:5173
