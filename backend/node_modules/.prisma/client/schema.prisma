generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(uuid())
  name             String
  role             UserRole
  status           UserStatus @default(PENDING)
  email            String     @unique
  password         String
  address          String
  phone            String?
  lat              Float?
  lng              Float?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  listings         Listing[]  @relation("ProviderListing")
  consumerListings Listing[]  @relation("ConsumerListing")
  ridesAsConsumer  Ride[]     @relation("ConsumerRide")

  @@map("users")
}

model Listing {
  id               String        @id @default(uuid())
  providerId       String
  provider         User          @relation("ProviderListing", fields: [providerId], references: [id])
  description      String
  servings         Int
  foodType         String
  location         String
  lat              Float?
  lng              Float?
  pickupStart      DateTime
  pickupEnd        DateTime
  status           ListingStatus @default(AVAILABLE)
  consumerId       String?
  consumer         User?         @relation("ConsumerListing", fields: [consumerId], references: [id])
  unit             String        @default("servings")
  weight           Float?
  packageCount     Int?
  dietary          String[]
  allergies        String?
  storage          String        @default("AMBIENT")
  prepInstructions String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  rides            Ride[]

  @@map("listings")
}

model Ride {
  id          String     @id @default(uuid())
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id])
  consumerId  String
  consumer    User       @relation("ConsumerRide", fields: [consumerId], references: [id])
  status      RideStatus @default(PENDING)
  startTime   DateTime?
  arrivalTime DateTime?
  endTime     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("rides")
}

enum UserRole {
  PROVIDER
  CONSUMER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  AVAILABLE
  CLAIMED
  EXPIRED
  COMPLETED
}

enum RideStatus {
  PENDING
  IN_PROGRESS
  ARRIVED
  COMPLETED
  CANCELLED
}
